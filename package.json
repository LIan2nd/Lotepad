{
  "name": "lotepad",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "postinstall": "node scripts/assets.mjs && node scripts/notices.mjs",
    "format": "prettier --write src tests *.ts *.json *.js",
    "dev:web": "vite --host 0.0.0.0",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "tauri": "node scripts/tauri.mjs",
    "test:rust": "node scripts/rust.mjs test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.4.1",
    "@tauri-apps/api": "^2.12.4",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "fractional-indexing": "^3.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.20",
      "sass": "^1.105.1",
      "@radix-ui/react-tabs": "^1.1.13"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "lodash-es": "^4.18.1",
    "katex": "^0.19.0"
  }
}
